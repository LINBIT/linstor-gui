{
  "name": "linstor-gui",
  "version": "2.7.0",
  "engines": {
    "node": ">=24"
  },
  "description": "Administration GUI for LINSTOR clusters.",
  "repository": "https://github.com/LINBIT/linstor-gui",
  "homepage": "https://linbit.com/linbit-gui/",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start:dev": "vite",
    "dev:mock": "VITE_LINSTOR_API_HOST=http://127.0.0.1:3478 vite",
    "prebuild": "npm run clean",
    "build": "vite build",
    "eslint": "eslint --max-warnings 0 --ext .tsx,.js ./src/",
    "lint": "npm run eslint",
    "format": "prettier --write --list-different './src/**/*.{ts,tsx,js,jsx,css}' '!src/app/apis/**'",
    "type-check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "clean": "rimraf dist",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest --run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest --coverage --run",
    "generate-api": "npm run generate-api:linstor && npm run generate-api:gateway",
    "generate-api:linstor": "openapi-typescript ./src/app/apis/Linstor-Linstor-1.30.0.yaml --output ./src/app/apis/schema.ts",
    "generate-api:gateway": "openapi-typescript ./src/app/apis/Linstor-linstor-gateway-2.0.0-resolved.yaml --output ./src/app/apis/gatewayschema.ts",
    "generate-agents": "node scripts/generate-ocf-agents.mjs --all --format ts --merge src/app/components/OcfAgentEditor/all_agents.ts --out src/app/components/OcfAgentEditor/all_agents.ts && prettier --write src/app/components/OcfAgentEditor/all_agents.ts",
    "generate-agents:release": "node scripts/generate-ocf-agents.mjs --all --release --format ts --merge src/app/components/OcfAgentEditor/all_agents.ts --out src/app/components/OcfAgentEditor/all_agents.ts && prettier --write src/app/components/OcfAgentEditor/all_agents.ts",
    "generate-agents:windows": "node scripts/generate-windows-agents.mjs",
    "prepare": "husky",
    "format:check": "prettier --check './src/**/*.{ts,tsx,js,jsx,css}' './e2e/**/*.ts' playwright.config.ts",
    "e2e": "playwright test",
    "e2e:mock": "node e2e/mock/server.js",
    "e2e:mock-spec": "node e2e/mock/scripts/generate-spec.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@types/react-dom": "^19.3.0",
    "@types/react-router-dom": "^5.1.7",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "openapi-typescript": "^7.6.1",
    "prettier": "^3.9.10",
    "rimraf": "^6.0.1",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "js-yaml": "^4.2.0",
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.3.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource/roboto": "^5.2.10",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-query": "^5.105.3",
    "antd": "^6.6.8",
    "apexcharts": "^8.7.0",
    "axios": "^1.21.0",
    "bignumber.js": "^11.1.5",
    "camelcase": "^10.0.0",
    "cron-parser": "^5.10.3",
    "dayjs": "^1.10.7",
    "i18next": "^26.7.1",
    "lodash": "^4.17.21",
    "openapi-fetch": "^0.17.0",
    "parse-prometheus-text-format": "^1.1.1",
    "react": "^19.3.1",
    "react-apexcharts": "^2.2.0",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11",
    "react-icons": "^5.5.0",
    "react-inlinesvg": "^4.6.0",
    "react-js-cron": "^6.0.2",
    "react-router-dom": "^7.18.5",
    "smol-toml": "^1.9.1",
    "vconsole": "^3.15.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.css": "prettier --write"
  },
  "allowScripts": {
    "core-js": false,
    "fsevents": false
  }
}
