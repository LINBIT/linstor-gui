{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(build)"
  ],
  "schedule": [
    "on monday"
  ],
  "timezone": "Europe/Vienna",
  "updateNotScheduled": false,
  "semanticCommits": "enabled",
  "semanticCommitScope": "deps",
  "commitBody": null,
  "prBodyTemplate": "{{{table}}}",
  "labels": [
    "Engineering"
  ],
  "packageRules": [
    {
      "description": "Minor and patch updates of everything in one MR a week",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "non-major dependencies"
    },
    {
      "description": "The Playwright image in CI must match @playwright/test",
      "matchPackageNames": [
        "@playwright/test",
        "mcr.microsoft.com/playwright"
      ],
      "groupName": "Playwright"
    },
    {
      "description": "Node and its types stay on the Node line the project runs on, the GitHub workflow included",
      "matchDepNames": [
        "node",
        "@types/node"
      ],
      "allowedVersions": "<25"
    },
    {
      "description": "The js-yaml override keeps openapi-typescript's YAML parser on 4.x, which it needs",
      "matchDepNames": [
        "js-yaml"
      ],
      "allowedVersions": "<5"
    },
    {
      "description": "TypeScript stays below 7 until typescript-eslint supports it (typescript-eslint/typescript-eslint#10940)",
      "matchDepNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "react-i18next majors need the matching i18next major, so both come in one MR",
      "matchPackageNames": [
        "i18next",
        "react-i18next"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "i18next"
    }
  ]
}
